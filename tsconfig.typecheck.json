{
  "extends": "./tsconfig.json",
  "contentMappers": [
    {
      "package": "@astrojs/ts-content-mapper",
      "extensions": [".astro"]
    }
  ],
  "include": [
    ".astro/types.d.ts",
    "src/**/*.ts",
    "packages/*/src/**/*.ts",
    "src/**/*.astro",
    "backend/**/*.ts",
    "alchemy.run.ts",
    "e2e/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["dist", "dist-dev"]
}
