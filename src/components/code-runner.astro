---
interface Props {
  source: string;
  input?: string;
  withInput?: boolean;
  draft?: string;
}

const { source, input = '', withInput = false, draft = '' } = Astro.props;
---

<section class="runner" data-code-runner data-draft={draft}>
  <div class="editor" data-role="editor" data-source={source}>
    <pre set:text={source} />
  </div>
  <label class="field" hidden={!withInput}>
    <span>輸入</span>
    <textarea
      data-role="stdin"
      class="stdin"
      rows="2"
      autocapitalize="off"
      autocomplete="off"
      spellcheck="false"
      set:text={input}
    />
  </label>
  <div class="bar">
    <button type="button" data-role="run">執行</button>
    <span data-role="status" class="status" aria-live="polite"></span>
    <kbd data-role="keycap" class="keycap" aria-hidden="true"></kbd>
    <span data-role="hint" class="hint"></span>
  </div>
  <pre data-role="output" class="output"></pre>
</section>

<script>
  import { mountRunners } from '@/lib/run/mount';

  mountRunners();
</script>

<style>
  .runner {
    display: grid;
    gap: 0.75rem;
  }
  .field {
    display: grid;
    gap: 0.25rem;
    color: var(--soft);
    font-size: 0.8125rem;
  }
  .field[hidden] {
    display: none;
  }
  .editor pre {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--panel);
  }
  textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 1rem;
    line-height: 1.6;
    resize: vertical;
    tab-size: 4;
  }
  textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .bar {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  button {
    padding: 0.45rem 1.4rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--accent);
    color: var(--panel);
    font: inherit;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.5;
    cursor: progress;
  }
  .status {
    color: var(--soft);
    font-size: 0.9375rem;
  }
  .keycap {
    min-width: 2.4rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--accent);
    border-radius: 0.4rem;
    background: var(--accent);
    color: var(--page);
    font-family: var(--mono);
    font-size: 1rem;
    text-align: center;
  }
  .keycap:empty {
    display: none;
  }
  .hint {
    margin-left: auto;
    color: var(--faint);
    font-size: 0.875rem;
    user-select: none;
  }
  .runner:not(:focus-within) .hint {
    visibility: hidden;
  }
  .runner[data-state='error'] .status {
    color: var(--bad);
  }
  .output {
    min-height: 3.5rem;
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--panel);
    font-size: 1rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
