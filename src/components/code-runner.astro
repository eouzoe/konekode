---
interface Props {
  source: string;
  input?: string;
}

const { source, input = '' } = Astro.props;
---

<section class="runner" data-code-runner>
  <label class="field">
    <span>程式</span>
    <textarea
      data-role="source"
      class="source"
      rows="14"
      autocapitalize="off"
      autocomplete="off"
      spellcheck="false"
      set:text={source}
    />
  </label>
  <label class="field">
    <span>輸入</span>
    <textarea
      data-role="stdin"
      class="stdin"
      rows="3"
      autocapitalize="off"
      autocomplete="off"
      spellcheck="false"
      set:text={input}
    />
  </label>
  <div class="bar">
    <button type="button" data-role="run">執行</button>
    <span data-role="status" class="status" aria-live="polite"></span>
  </div>
  <pre data-role="output" class="output"></pre>
</section>

<script>
  import { mountRunners } from '@/lib/run/mount';

  mountRunners();
</script>

<style>
  .runner {
    display: grid;
    gap: 0.75rem;
  }
  .field {
    display: grid;
    gap: 0.25rem;
    color: var(--soft);
    font-size: 0.8125rem;
  }
  textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 1rem;
    line-height: 1.6;
    resize: vertical;
    tab-size: 4;
  }
  textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .bar {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  button {
    padding: 0.45rem 1.4rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--accent);
    color: var(--panel);
    font: inherit;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.5;
    cursor: progress;
  }
  .status {
    color: var(--soft);
    font-size: 0.9375rem;
  }
  .runner[data-state='error'] .status {
    color: var(--bad);
  }
  .output {
    min-height: 3.5rem;
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--panel);
    font-size: 1rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
