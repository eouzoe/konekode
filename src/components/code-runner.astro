---
import { ui } from '@/lib/text/ui';

interface Props {
  source: string;
  input?: string;
  withInput?: boolean;
  draft?: string;
}

const { source, input = '', withInput = false, draft = '' } = Astro.props;
---

<section class="runner" data-code-runner data-draft={draft}>
  <div class="editor" data-role="editor" data-source={source}>
    <pre set:text={source} />
  </div>
  <div class="keys" data-role="keys" aria-hidden="true" hidden></div>
  <div class="io">
    <div class="field" data-role="field" hidden={!withInput}>
      <span>{ui['page.input']}</span>
      <pre data-role="stdin" class="stdin" set:text={input} />
    </div>
    <div class="field" data-role="expect-field" hidden>
      <span>{ui['page.expect']}</span>
      <pre data-role="expect" class="stdin"></pre>
    </div>
  </div>
  <div class="bar">
    <button type="button" data-role="run">{ui['page.run']}</button>
    <span data-role="status" class="status" aria-live="polite"></span>
    <kbd data-role="keycap" class="keycap" aria-hidden="true"></kbd>
    <span data-role="hint" class="hint"></span>
  </div>
  <pre data-role="output" class="output"></pre>
</section>

<script>
  import { mountRunners } from '@/lib/run/mount';

  mountRunners();
</script>

<style>
  .runner {
    display: grid;
    gap: 0.75rem;
  }
  .field {
    display: grid;
    gap: 0.25rem;
    color: var(--soft);
    font-size: 0.8125rem;
  }
  .field[hidden],
  .runner[data-guided='true'] [data-role='expect-field'] {
    display: none;
  }
  .io {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    gap: 0.75rem;
  }
  .io:not(:has(.field:not([hidden]))) {
    display: none;
  }
  .editor {
    position: relative;
  }
  .editor:focus {
    outline: none;
  }
  .runner[data-armed='true'] .editor :global(.cm-editor) {
    outline: 2px solid var(--accent);
  }
  .editor :global(.mode) {
    margin: 0.35rem 0 0;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.875rem;
  }
  .editor :global(.effect) {
    position: absolute;
    right: 0;
    bottom: -0.15rem;
    margin: 0;
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--page);
    font-size: 0.9375rem;
    opacity: 0;
    pointer-events: none;
  }
  .editor :global(.effect:empty) {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .runner[data-armed='true'] .editor :global(.cm-own-landed-0)::before {
      animation: cursor-lands-a 0.5s ease-out;
    }
    .runner[data-armed='true'] .editor :global(.cm-own-landed-1)::before {
      animation: cursor-lands-b 0.5s ease-out;
    }
  }
  @keyframes cursor-lands-a {
    from {
      box-shadow: 0 0 0 0.9rem color-mix(in srgb, var(--accent) 45%, transparent);
    }
    to {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  @keyframes cursor-lands-b {
    from {
      box-shadow: 0 0 0 0.9rem color-mix(in srgb, var(--accent) 45%, transparent);
    }
    to {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .editor :global(.cm-own-line) {
    position: relative;
    z-index: 0;
  }
  .editor :global(.cm-own-line)::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(6px + var(--column) * 1ch);
    z-index: -1;
    pointer-events: none;
  }
  .editor :global(.cm-own-normal)::before {
    width: 1ch;
    outline: 1px solid #7aa2f7;
  }
  .editor[data-actor='sprite'] :global(.cm-own-normal)::before,
  .runner[data-armed='true'] .editor :global(.cm-own-normal)::before {
    background: #3d59a1;
    outline: none;
  }
  .editor[data-actor='sprite'] :global(.cm-own-insert)::before,
  .runner[data-armed='true'] .editor :global(.cm-own-insert)::before {
    border-left: 2px solid var(--ink);
    margin-left: -1px;
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    color: var(--faint);
    font-size: 0.8125rem;
    transition: opacity 0.2s;
  }
  .keys[hidden] {
    display: none;
  }
  .keys[data-mode='insert'],
  .runner:not([data-armed='true']) .keys {
    opacity: 0.45;
  }
  .keys :global(span) {
    margin-right: 0.3rem;
  }
  .keys :global(kbd) {
    min-width: 1.9rem;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--line);
    border-bottom-width: 3px;
    border-radius: 0.4rem;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.9375rem;
    text-align: center;
  }
  .runner[data-armed='true'] .keys:not([data-mode='insert']) :global(kbd[data-next='true']) {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--page);
  }
  @media (prefers-reduced-motion: no-preference) {
    .keys :global(kbd[data-fresh='true']) {
      animation: key-arrives 0.9s ease-out;
    }
    .runner[data-armed='true'] .keys:not([data-mode='insert']) :global(kbd[data-next='true']) {
      animation: key-waits 1.4s ease-in-out infinite;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .runner[data-wrong='true'] .keys :global(kbd[data-next='true']) {
      animation: key-nudges 0.35s ease-in-out;
    }
  }
  .runner[data-wrong='true'] .editor :global(.cm-ghost) {
    opacity: 0.7;
  }
  @keyframes key-nudges {
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
    }
  }
  @keyframes key-arrives {
    from {
      transform: translateY(-0.9rem) scale(1.5);
      opacity: 0;
      border-color: var(--accent);
    }
    60% {
      transform: translateY(0) scale(1.15);
      opacity: 1;
      border-color: var(--accent);
    }
  }
  @keyframes key-waits {
    50% {
      transform: translateY(-2px);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent);
    }
  }
  .editor :global(.cm-ghost) {
    color: var(--ink);
    opacity: 0.38;
    transition: opacity 0.25s;
  }
  .editor :global(.cm-ghost-line) {
    padding: 0 2px 0 6px;
    white-space: pre;
  }
  .editor :global(.cm-ghost-drop),
  .editor :global(.cm-ghost-remove) {
    opacity: 0.45;
    text-decoration: line-through;
  }
  .editor pre {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--panel);
  }
  .stdin {
    min-height: 1.6rem;
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 1rem;
    line-height: 1.6;
    white-space: pre-wrap;
    user-select: none;
  }
  .bar {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  button {
    padding: 0.45rem 1.4rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--accent);
    color: var(--panel);
    font: inherit;
    cursor: pointer;
  }
  .runner:not([data-armed='true']) button {
    visibility: hidden;
  }
  button:disabled {
    opacity: 0.5;
    cursor: progress;
  }
  .status {
    color: var(--soft);
    font-size: 0.9375rem;
  }
  .keycap {
    min-width: 2.4rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--accent);
    border-radius: 0.4rem;
    background: var(--accent);
    color: var(--page);
    font-family: var(--mono);
    font-size: 1rem;
    text-align: center;
  }
  .keycap:empty {
    display: none;
  }
  .hint {
    flex: 1;
    order: -1;
    color: var(--faint);
    font-size: 0.875rem;
    user-select: none;
  }
  .runner:not([data-armed='true']) .hint {
    visibility: hidden;
  }
  .runner[data-guided='true'] .hint {
    color: var(--ink);
    font-size: 1.1875rem;
  }
  .runner[data-guided='true'][data-wrong='true'] .hint {
    color: var(--bad);
  }
  .runner[data-state='error'] .status {
    color: var(--bad);
  }
  .runner:not([data-state='busy']) .output:empty {
    display: none;
  }
  .output {
    min-height: 3.5rem;
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--panel);
    font-size: 1rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
