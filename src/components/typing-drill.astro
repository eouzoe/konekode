---
import { ui } from '@/lib/text/ui';

interface Props {
  target: string;
}

const { target } = Astro.props;
---

<section class="drill" data-typing-drill data-target={target}>
  <div class="drill-top">
    <pre
      class="drill-code"><span data-role="done" class="is-done" /><span data-role="current" class="is-current" /><span data-role="rest" class="is-rest" /></pre>
    <p class="drill-mode" data-role="mode"></p>
    <div data-role="input" class="drill-input" tabindex="0" aria-label={ui['page.typeHere']}></div>
  </div>
  <div class="drill-bottom">
    <p data-role="hint" class="drill-hint" aria-live="polite"></p>
    <div data-role="keyboard" class="keyboard" aria-hidden="true"></div>
  </div>
</section>

<script>
  import { mountAll } from '@/lib/typing/mount';

  mountAll();
</script>

<style>
  .drill {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem;
    height: 100%;
    min-height: 24rem;
    cursor: text;
  }
  .drill-top {
    position: relative;
    display: grid;
    align-content: safe center;
    min-height: 0;
    overflow-y: auto;
  }
  .drill-code {
    margin: 0;
    padding: 1.25rem 1.25rem 2.25rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--panel);
    font-family: var(--mono);
    font-size: 1.375rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .drill:focus-within .drill-code {
    border-color: var(--accent);
  }
  .is-done {
    color: var(--ink);
  }
  .is-current {
    background: var(--accent);
    color: var(--panel);
    border-radius: 0.2rem;
  }
  .is-rest {
    color: var(--faint);
  }
  .is-rest :global(.is-auto) {
    color: var(--soft);
  }
  .drill[data-wrong='true'] .is-current {
    background: var(--bad);
  }
  .drill[data-done='true'] .is-current {
    display: none;
  }
  .drill-mode {
    position: absolute;
    left: 1.25rem;
    bottom: 0.5rem;
    margin: 0;
    color: var(--soft);
    font-family: var(--mono);
    font-size: 0.875rem;
    user-select: none;
  }
  .drill[data-mode='normal'] .is-current {
    background: none;
    color: var(--faint);
    outline: 2px solid var(--accent);
  }
  .drill-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    border: 0;
    cursor: text;
  }
  .keyboard,
  .drill-hint {
    user-select: none;
  }
  .drill-hint {
    min-height: 1.6em;
    margin: 0 0 0.75rem;
    text-align: center;
    color: var(--soft);
  }
  .drill[data-wrong='true'] .drill-hint {
    color: var(--bad);
  }
  .keyboard {
    display: grid;
    gap: 0.3rem;
    justify-content: center;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
  .keyboard :global(.key-row) {
    display: flex;
    gap: 0.35rem;
    justify-content: center;
  }
  .keyboard :global(.key) {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.3rem;
    padding: 0 0.4rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    background: var(--panel);
    color: var(--soft);
    white-space: nowrap;
  }
  .keyboard :global(.key[data-wide='true']) {
    min-width: 5.5rem;
  }
  .keyboard :global(.key[data-key='Space']) {
    min-width: 18rem;
  }
  .keyboard :global(.key[data-down='true']) {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--page);
    translate: 0 2px;
  }
  .keyboard :global(.key[data-next='true']) {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--panel);
  }
  @media (pointer: coarse) {
    .keyboard {
      display: none;
    }
  }
  @media (max-height: 50rem) {
    .drill {
      gap: 0.75rem;
    }
    .drill-code {
      padding-top: 0.9rem;
      font-size: 1.25rem;
    }
    .drill-hint {
      margin-bottom: 0.5rem;
    }
    .keyboard :global(.key) {
      height: 2.1rem;
    }
  }
</style>
