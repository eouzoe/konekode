---
import '@konekode/views/home.css';

import Base from '@/layouts/base.astro';
import { pages, site, websiteData } from '@/lib/site/pages';

const data = websiteData(Astro.site ?? Astro.url);
---

<Base page={pages.home} data={data} full>
  <div class="home">
    <div class="scene" data-role="scene"></div>
    <h1 class="unseen">{site['home.heading']}</h1>
    <button class="account" data-role="around" type="button">{site['home.account']}</button>
    <div class="actions" data-role="around">
      <a class="start" href={pages.start.path} data-prepare>{site['home.start']}</a>
    </div>
  </div>
</Base>

<script>
  const begin = async (): Promise<void> => {
    const { startTitle } = await import('@konekode/views/title');
    await startTitle({
      probe: import.meta.env.DEV || import.meta.env.PUBLIC_MODE === 'dev',
      ...(import.meta.env.DEV ? { unitHref: '/art/unit' } : {}),
    });
  };

  addEventListener(
    'load',
    () => {
      void begin();
    },
    { once: true },
  );
</script>
