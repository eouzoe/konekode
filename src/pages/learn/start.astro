---
import CodeRunner from '@/components/code-runner.astro';
import TypingDrill from '@/components/typing-drill.astro';
import Base from '@/layouts/base.astro';
import { fullscreenMark } from '@/lib/scene/conditions';
import { fullscreenKeys } from '@/lib/site/device';
import { lessonData, pages, site } from '@/lib/site/pages';
import { dues } from '@/lib/supply/plan';
import { rules } from '@/lib/supply/rules';
import { ui } from '@konekode/course/ui';
import { beats, starter, template } from '@konekode/course/start';

const codeLines = template.split('\n');
const data = lessonData(Astro.site ?? Astro.url, pages.start);
const needs = JSON.stringify(dues(beats, rules));
const opening = beats[0]?.stage ?? 'empty';
const defaultKey = ui[fullscreenKeys.pc];
---

<Base page={pages.start} data={data} full>
  <p class="plain">{site['start.plain']} <a href={pages.home.path}>{site.name}</a></p>
  <section
    class="scene"
    data-scene
    data-unit="start"
    data-stage={opening}
    data-needs={needs}
    data-prefetch="compiler"
  >
    <div class="stage">
      <p class="supplying" role="status">{ui['page.supplying']}</p>
      <div class="code" data-show="code">
        {codeLines.map((line, at) => <span class="line" data-line={String(at + 1)} set:text={line} />)}
      </div>
      <div class="drill-slot" data-show="drill">
        <TypingDrill target={template} />
      </div>
      <div class="run-slot" data-show="run">
        <CodeRunner source={starter} draft="start">
          <pre slot="aside" class="snippet" data-role="snippet"></pre>
        </CodeRunner>
      </div>
    </div>

    <div class="dialogue" data-role="dialogue">
      <span class="who">{ui['page.who']}</span>
      <div class="words">
        {
          beats.map((beat) => (
            <p
              data-beat
              data-id={beat.id}
              data-stage={beat.stage}
              data-lines={beat.lines}
              data-wait={beat.wait}
              data-free={beat.free}
              data-snippet={beat.snippet}
              data-expect={beat.expect}
              data-input={beat.input}
              data-auto={beat.auto}
              data-append={beat.append}
              data-demo={beat.demo}
              data-keys={beat.keys === undefined ? undefined : JSON.stringify(beat.keys)}
              data-after={beat.after}
              data-when={beat.when}
              data-needs={beat.needs}
              data-unlock={beat.unlock?.join(',')}
            >
              {beat.say.split(fullscreenMark).map((part, at) => (
                <>
                  {at > 0 && <span data-fullscreen-key>{defaultKey}</span>}
                  {part}
                </>
              ))}
            </p>
          ))
        }
      </div>
      <p class="note" data-role="note" aria-live="polite"></p>
      <div class="tools">
        <button class="back" type="button" data-role="back">{ui['page.back']}</button>
        <button class="back" type="button" data-role="restart">{ui['page.restart']}</button>
      </div>
      <span class="more" aria-hidden="true">
        <span class="by-key">{ui['page.moreByKey']}</span>
        <span class="by-tap">{ui['page.moreByTap']}</span>
        ▼
      </span>
    </div>
  </section>
</Base>

<script>
  import { guard } from '@/lib/fault/fault';
  import { mountScenes } from '@/lib/scene/start';

  guard('scenes', mountScenes());
</script>

<style>
  .plain {
    display: none;
    margin: 0;
    padding: 1rem;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
  }
  .plain a {
    color: var(--accent);
  }
  .scene {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem;
    width: min(100% - 3rem, 80rem);
    height: 100dvh;
    margin: 0 auto;
    padding: 1.5rem 0;
  }
  .scene:not([data-ready='true']) [data-beat]:not(:first-child) {
    display: none;
  }
  :global(:root.on-touch) [data-needs='fullscreen-key'] {
    display: none;
  }
  :global(:root.on-touch)
    .scene:not([data-ready='true'])
    [data-needs='fullscreen-key']
    + [data-beat]:not([data-needs='fullscreen-key']) {
    display: block;
  }
  @media not all and (any-pointer: fine) {
    [data-needs='fullscreen-key'] {
      display: none;
    }
    .scene:not([data-ready='true'])
      [data-needs='fullscreen-key']
      + [data-beat]:not([data-needs='fullscreen-key']) {
      display: block;
    }
  }
  .scene:not([data-ready='true']) .tools {
    visibility: hidden;
  }
  .stage {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    min-height: 0;
    overflow-y: auto;
  }
  .supplying {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    margin: 0;
    background: color-mix(in oklch, var(--page) 70%, transparent);
    color: var(--soft);
    font-size: 1.125rem;
  }
  .supplying::after {
    content: '';
    width: 10rem;
    height: 0.25rem;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent) 0 0 / 50% 100%
      no-repeat var(--line);
    animation: sweep 1.2s linear infinite;
  }
  @keyframes sweep {
    from {
      background-position: -50% 0;
    }
    to {
      background-position: 150% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .supplying::after {
      animation: none;
      background-position: 50% 0;
    }
  }
  .scene[data-ready='true'][data-supplying='true'] .supplying {
    display: grid;
  }
  .code {
    align-self: safe center;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--panel);
    font-family: var(--mono);
    font-size: 1.375rem;
    line-height: 1.7;
    width: min(100%, 52rem);
    overflow-x: auto;
  }
  .line {
    display: block;
    margin: 0 -0.5rem;
    padding: 0 0.5rem;
    border-radius: 0.3rem;
    min-height: 1.7em;
    white-space: pre;
    transition: background-color 0.2s;
  }
  .line[data-marked='true'] {
    background: color-mix(in oklch, var(--accent) 22%, transparent);
  }
  .scene [data-show] {
    display: none;
    animation: appear 0.45s ease both;
  }
  @keyframes appear {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene [data-show] {
      animation: none;
    }
  }
  .scene[data-stage='code'] .code[data-show] {
    display: block;
  }
  .scene[data-stage='drill'] .drill-slot[data-show] {
    display: block;
    height: 100%;
  }
  .scene[data-stage='run'] .run-slot[data-show] {
    position: relative;
    display: block;
    align-self: safe center;
    width: min(100%, 60rem);
    height: min(100%, 46rem);
    min-height: 27rem;
    margin: 0 auto;
  }
  .snippet {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    max-width: 55%;
    margin: 0;
    padding: 0.5rem 1rem;
    border-left: 3px solid var(--accent);
    border-radius: 0.4rem;
    background: color-mix(in oklch, var(--accent) 16%, var(--panel));
    font-size: 1.125rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    pointer-events: none;
  }
  @media (min-width: 62rem) and (max-height: 50rem) {
    .scene[data-stage='run'] .run-slot[data-show] {
      width: 100%;
    }
    .snippet {
      position: static;
      align-self: start;
      max-width: none;
      max-height: 100%;
      overflow-y: auto;
    }
  }
  .snippet:empty,
  .run-slot:has([data-code-runner][data-guided='true'][data-armed='true']) .snippet {
    display: none;
  }
  .dialogue {
    --shown-lines: 2;
    --edge: 1.25rem;
    --note-line: 1.75rem;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0 1rem;
    align-items: start;
    min-height: 7.5rem;
    padding: var(--edge) 1.75rem;
    border: 1px solid var(--line);
    border-radius: 1.1rem;
    background: var(--panel);
    grid-template-rows: minmax(0, 1fr) var(--note-line);
    height: calc(var(--shown-lines) * 1lh + 2 * var(--edge) + var(--note-line) + 2px);
    font-size: 1.375rem;
    line-height: 1.75;
    cursor: pointer;
  }
  @media (max-width: 60rem) and (min-height: 50.0625rem), (max-width: 52rem) {
    .dialogue {
      --shown-lines: 3;
    }
  }
  @media (max-height: 50rem) {
    .scene {
      gap: 0.75rem;
      padding: 1rem 0;
    }
    .dialogue {
      --edge: 0.9rem;
      --note-line: 1.6rem;
      font-size: 1.25rem;
      line-height: 1.7;
    }
  }
  .who,
  .tools,
  .more,
  .snippet {
    user-select: none;
  }
  .scene[data-waiting='true'] .dialogue {
    cursor: default;
  }
  .who {
    padding: 0.1rem 0.7rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--page);
    font-size: 0.8125rem;
    line-height: 1.8;
    white-space: nowrap;
  }
  .words {
    min-width: 0;
    max-height: 100%;
    overflow-y: auto;
    overflow-wrap: anywhere;
  }
  .words p {
    margin: 0;
  }
  .note {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    overflow: hidden;
    color: var(--bad);
    font-size: 1rem;
    line-height: var(--note-line);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .tools {
    display: grid;
    grid-column: 3;
    grid-row: 1;
    justify-items: end;
  }
  .back {
    border: 0;
    background: none;
    color: var(--soft);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .more {
    position: absolute;
    right: 1.5rem;
    bottom: 0.9rem;
    color: var(--accent);
    font-size: 0.8125rem;
    animation: bob 1.2s ease-in-out infinite;
  }
  @media (width < 40rem) {
    .dialogue {
      --shown-lines: 4;
      --edge: 1rem;
      --head: 2rem;
      grid-template-columns: auto 1fr;
      gap: 0 1rem;
      padding: var(--edge) 1.25rem;
      font-size: 1.125rem;
    }
    .scene[data-ready='true'] .dialogue {
      grid-template-rows: var(--head) minmax(0, 1fr) var(--note-line);
      height: calc(
        var(--shown-lines) * 1lh + 2 * var(--edge) + var(--head) + var(--note-line) + 2px
      );
    }
    .words {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .note {
      grid-column: 1 / -1;
      grid-row: 3;
    }
    .tools {
      display: flex;
      grid-column: 2;
      grid-row: 1;
      gap: 1rem;
      justify-content: end;
    }
    .more {
      right: 1.25rem;
      bottom: 0.5rem;
    }
  }
  .by-tap {
    display: none;
  }
  @media (pointer: coarse) {
    .by-key {
      display: none;
    }
    .by-tap {
      display: inline;
    }
  }
  .scene:not([data-ready='true']) .more,
  .scene[data-waiting='true'] .more,
  .scene[data-revealing='true'] .more,
  .scene[data-last='true'] .more {
    display: none;
  }
  @keyframes bob {
    50% {
      translate: 0 0.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .more {
      animation: none;
    }
  }
  @media (scripting: none) {
    .plain {
      display: block;
    }
    .scene {
      height: auto;
    }
    .scene [data-show],
    .scene:not([data-ready='true']) [data-beat]:not(:first-child) {
      display: block;
      animation: none;
    }
    .dialogue {
      grid-template-rows: none;
      height: auto;
      cursor: auto;
    }
    .words {
      max-height: none;
      overflow-y: visible;
    }
    .words p {
      margin: 0 0 0.5rem;
    }
    .note:empty,
    .tools {
      display: none;
    }
  }
</style>
