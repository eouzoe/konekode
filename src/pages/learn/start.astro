---
import CodeRunner from '@/components/code-runner.astro';
import TypingDrill from '@/components/typing-drill.astro';
import Base from '@/layouts/base.astro';
import { beats, starter, template } from '@/units/start';

const codeLines = template.split('\n');
---

<Base title="起步" full>
  <section class="scene" data-scene data-unit="start">
    <div class="stage">
      <div class="code" data-show="code">
        {codeLines.map((line, at) => <span class="line" data-line={String(at + 1)} set:text={line} />)}
      </div>
      <div class="drill-slot" data-show="drill">
        <TypingDrill target={template} />
      </div>
      <div class="run-slot" data-show="run">
        <pre class="snippet" data-role="snippet"></pre>
        <CodeRunner source={starter} draft="start" />
      </div>
    </div>

    <div class="dialogue" data-role="dialogue">
      <span class="who">小精靈</span>
      <div class="words">
        {
          beats.map((beat) => (
            <p
              data-beat
              data-id={beat.id}
              data-stage={beat.stage}
              data-lines={beat.lines}
              data-wait={beat.wait}
              data-snippet={beat.snippet}
              data-expect={beat.expect}
              data-input={beat.input}
            >
              {beat.say}
            </p>
          ))
        }
      </div>
      <p class="note" data-role="note" aria-live="polite"></p>
      <div class="tools">
        <button class="back" type="button" data-role="back">上一句</button>
        <button class="back" type="button" data-role="restart">從頭開始</button>
      </div>
      <span class="more" aria-hidden="true">
        <span class="by-key">按任意鍵繼續</span>
        <span class="by-tap">點一下繼續</span>
        ▼
      </span>
    </div>
  </section>
</Base>

<script>
  import { mountScenes } from '@/lib/scene/mount';

  mountScenes();
</script>

<style>
  .scene {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
    width: min(100% - 2rem, 60rem);
    margin: 0 auto;
    padding: 1.5rem 0;
  }
  .scene[data-ready='true'] {
    height: 100dvh;
  }
  .stage {
    display: grid;
    align-content: center;
    min-height: 0;
  }
  .code {
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--panel);
    font-family: var(--mono);
    font-size: 1.125rem;
    line-height: 1.7;
    width: min(100%, 40rem);
    overflow-x: auto;
  }
  .line {
    display: block;
    margin: 0 -0.5rem;
    padding: 0 0.5rem;
    border-radius: 0.3rem;
    min-height: 1.7em;
    white-space: pre;
    transition: background-color 0.2s;
  }
  .line[data-marked='true'] {
    background: color-mix(in oklch, var(--accent) 22%, transparent);
  }
  .scene[data-ready='true'] [data-show] {
    display: none;
  }
  .scene[data-stage='code'] .code[data-show] {
    display: block;
  }
  .scene[data-stage='drill'] .drill-slot[data-show] {
    display: block;
    height: 100%;
  }
  .scene[data-stage='run'] .run-slot[data-show] {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 44rem);
    margin: 0 auto;
  }
  .snippet {
    margin: 0;
    padding: 0.5rem 1rem;
    border-left: 3px solid var(--accent);
    background: color-mix(in oklch, var(--accent) 12%, transparent);
    font-size: 1.125rem;
  }
  .snippet:empty {
    display: none;
  }
  .dialogue {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: start;
    min-height: 6.5rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: var(--panel);
    font-size: 1.1875rem;
  }
  .scene[data-ready='true'] .dialogue {
    cursor: pointer;
  }
  .who,
  .tools,
  .more,
  .snippet {
    user-select: none;
  }
  .scene[data-waiting='true'] .dialogue {
    cursor: default;
  }
  .who {
    padding: 0.1rem 0.7rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--page);
    font-size: 0.8125rem;
    line-height: 1.8;
    white-space: nowrap;
  }
  .words p {
    margin: 0 0 0.5rem;
  }
  .scene[data-ready='true'] .words p {
    margin: 0;
  }
  .note {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    color: var(--bad);
    font-size: 1rem;
  }
  .note:empty {
    display: none;
  }
  .tools {
    display: grid;
    grid-column: 3;
    grid-row: 1;
    justify-items: end;
  }
  .scene:not([data-ready='true']) .tools {
    display: none;
  }
  .back {
    border: 0;
    background: none;
    color: var(--soft);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .more {
    position: absolute;
    right: 1.1rem;
    bottom: 0.6rem;
    color: var(--accent);
    font-size: 0.8125rem;
    animation: bob 1.2s ease-in-out infinite;
  }
  .by-tap {
    display: none;
  }
  @media (pointer: coarse) {
    .by-key {
      display: none;
    }
    .by-tap {
      display: inline;
    }
  }
  .scene:not([data-ready='true']) .more,
  .scene:not([data-ready='true']) .back,
  .scene[data-waiting='true'] .more,
  .scene[data-last='true'] .more {
    display: none;
  }
  @keyframes bob {
    50% {
      translate: 0 0.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .more {
      animation: none;
    }
  }
</style>
