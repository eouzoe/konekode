---
import CodeRunner from '@/components/code-runner.astro';
import TypingDrill from '@/components/typing-drill.astro';
import Base from '@/layouts/base.astro';
import { lessonData, pages, site } from '@/lib/site/pages';
import { ui } from '@/lib/text/ui';
import { beats, starter, template } from '@/units/start';

const codeLines = template.split('\n');
const data = lessonData(Astro.site ?? Astro.url, pages.start);
---

<Base page={pages.start} data={data} full>
  <p class="plain">{site['start.plain']} <a href={pages.home.path}>{site.name}</a></p>
  <p class="needs-keyboard">{ui['page.needsKeyboard']}</p>
  <section class="scene" data-scene data-unit="start">
    <div class="stage">
      <div class="code" data-show="code">
        {codeLines.map((line, at) => <span class="line" data-line={String(at + 1)} set:text={line} />)}
      </div>
      <div class="drill-slot" data-show="drill">
        <TypingDrill target={template} />
      </div>
      <div class="run-slot" data-show="run">
        <CodeRunner source={starter} draft="start">
          <pre slot="aside" class="snippet" data-role="snippet"></pre>
        </CodeRunner>
      </div>
    </div>

    <div class="dialogue" data-role="dialogue">
      <span class="who">{ui['page.who']}</span>
      <div class="words">
        {
          beats.map((beat) => (
            <p
              data-beat
              data-id={beat.id}
              data-stage={beat.stage}
              data-lines={beat.lines}
              data-wait={beat.wait}
              data-snippet={beat.snippet}
              data-expect={beat.expect}
              data-input={beat.input}
              data-auto={beat.auto}
              data-append={beat.append}
              data-demo={beat.demo}
              data-keys={beat.keys === undefined ? undefined : JSON.stringify(beat.keys)}
              data-after={beat.after}
              data-when={beat.when}
              data-unlock={beat.unlock?.join(',')}
            >
              {beat.say}
            </p>
          ))
        }
      </div>
      <p class="note" data-role="note" aria-live="polite"></p>
      <div class="tools">
        <button class="back" type="button" data-role="back">{ui['page.back']}</button>
        <button class="back" type="button" data-role="restart">{ui['page.restart']}</button>
      </div>
      <span class="more" aria-hidden="true">
        <span class="by-key">{ui['page.moreByKey']}</span>
        <span class="by-tap">{ui['page.moreByTap']}</span>
        ▼
      </span>
    </div>
  </section>
</Base>

<script>
  import { guard } from '@/lib/fault/fault';
  import { mountScenes } from '@/lib/scene/mount';

  guard('scenes', mountScenes());
</script>

<style>
  .plain {
    margin: 0;
    padding: 1rem;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
  }
  .plain a {
    color: var(--accent);
  }
  @media (scripting: enabled) {
    .plain {
      display: none;
    }
  }
  .needs-keyboard {
    display: none;
    margin: 0;
    padding: 0.6rem 1rem;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-align: center;
  }
  @media (pointer: coarse) and (hover: none) {
    .needs-keyboard {
      display: block;
    }
  }
  .scene {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem;
    width: min(100% - 3rem, 80rem);
    margin: 0 auto;
    padding: 1.5rem 0;
  }
  .scene[data-ready='true'] {
    height: 100dvh;
  }
  @media (scripting: enabled) {
    .scene:not([data-ready='true']) {
      visibility: hidden;
    }
  }
  .stage {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    min-height: 0;
    overflow-y: auto;
  }
  .code {
    align-self: safe center;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--panel);
    font-family: var(--mono);
    font-size: 1.375rem;
    line-height: 1.7;
    width: min(100%, 52rem);
    overflow-x: auto;
  }
  .line {
    display: block;
    margin: 0 -0.5rem;
    padding: 0 0.5rem;
    border-radius: 0.3rem;
    min-height: 1.7em;
    white-space: pre;
    transition: background-color 0.2s;
  }
  .line[data-marked='true'] {
    background: color-mix(in oklch, var(--accent) 22%, transparent);
  }
  .scene[data-ready='true'] [data-show] {
    display: none;
    animation: appear 0.45s ease both;
  }
  @keyframes appear {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene[data-ready='true'] [data-show] {
      animation: none;
    }
  }
  .scene[data-stage='code'] .code[data-show] {
    display: block;
  }
  .scene[data-stage='drill'] .drill-slot[data-show] {
    display: block;
    height: 100%;
  }
  .scene[data-stage='run'] .run-slot[data-show] {
    position: relative;
    display: block;
    align-self: safe center;
    width: min(100%, 60rem);
    height: min(100%, 46rem);
    min-height: 27rem;
    margin: 0 auto;
  }
  .snippet {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    max-width: 55%;
    margin: 0;
    padding: 0.5rem 1rem;
    border-left: 3px solid var(--accent);
    border-radius: 0.4rem;
    background: color-mix(in oklch, var(--accent) 16%, var(--panel));
    font-size: 1.125rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    pointer-events: none;
  }
  @media (min-width: 62rem) and (max-height: 50rem) {
    .scene[data-stage='run'] .run-slot[data-show] {
      width: 100%;
    }
    .snippet {
      position: static;
      align-self: start;
      max-width: none;
      max-height: 100%;
      overflow-y: auto;
    }
  }
  .snippet:empty,
  .run-slot:has([data-code-runner][data-guided='true'][data-armed='true']) .snippet {
    display: none;
  }
  .dialogue {
    --shown-lines: 2;
    --edge: 1.25rem;
    --note-line: 1.75rem;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0 1rem;
    align-items: start;
    min-height: 7.5rem;
    padding: var(--edge) 1.75rem;
    border: 1px solid var(--line);
    border-radius: 1.1rem;
    background: var(--panel);
    font-size: 1.375rem;
    line-height: 1.75;
  }
  .scene[data-ready='true'] .dialogue {
    grid-template-rows: minmax(0, 1fr) var(--note-line);
    height: calc(var(--shown-lines) * 1lh + 2 * var(--edge) + var(--note-line) + 2px);
    cursor: pointer;
  }
  @media (max-width: 60rem) and (min-height: 50.0625rem), (max-width: 52rem) {
    .dialogue {
      --shown-lines: 3;
    }
  }
  @media (max-height: 50rem) {
    .scene {
      gap: 0.75rem;
      padding: 1rem 0;
    }
    .dialogue {
      --edge: 0.9rem;
      --note-line: 1.6rem;
      font-size: 1.25rem;
      line-height: 1.7;
    }
  }
  .who,
  .tools,
  .more,
  .snippet {
    user-select: none;
  }
  .scene[data-waiting='true'] .dialogue {
    cursor: default;
  }
  .who {
    padding: 0.1rem 0.7rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--page);
    font-size: 0.8125rem;
    line-height: 1.8;
    white-space: nowrap;
  }
  .words {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .scene[data-ready='true'] .words {
    max-height: 100%;
    overflow-y: auto;
  }
  .words p {
    margin: 0 0 0.5rem;
  }
  .scene[data-ready='true'] .words p {
    margin: 0;
  }
  .note {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    overflow: hidden;
    color: var(--bad);
    font-size: 1rem;
    line-height: var(--note-line);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .scene:not([data-ready='true']) .note:empty {
    display: none;
  }
  .tools {
    display: grid;
    grid-column: 3;
    grid-row: 1;
    justify-items: end;
  }
  .scene:not([data-ready='true']) .tools {
    display: none;
  }
  .back {
    border: 0;
    background: none;
    color: var(--soft);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .more {
    position: absolute;
    right: 1.5rem;
    bottom: 0.9rem;
    color: var(--accent);
    font-size: 0.8125rem;
    animation: bob 1.2s ease-in-out infinite;
  }
  .by-tap {
    display: none;
  }
  @media (pointer: coarse) {
    .by-key {
      display: none;
    }
    .by-tap {
      display: inline;
    }
  }
  .scene:not([data-ready='true']) .more,
  .scene:not([data-ready='true']) .back,
  .scene[data-waiting='true'] .more,
  .scene[data-revealing='true'] .more,
  .scene[data-last='true'] .more {
    display: none;
  }
  @keyframes bob {
    50% {
      translate: 0 0.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .more {
      animation: none;
    }
  }
</style>
