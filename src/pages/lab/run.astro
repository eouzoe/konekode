---
import CodeRunner from '@/components/code-runner.astro';
import Base from '@/layouts/base.astro';

const source = `#include <bits/stdc++.h>
using namespace std;

int main()
{
    cin.tie(nullptr)->sync_with_stdio(false);

    int a{};
    int b{};
    cin >> a >> b;
    cout << b << ' ' << a << '\\n';
}`;
---

<Base title="執行測試">
  <h1>執行測試</h1>
  <CodeRunner source={source} input="3 5" />
</Base>
