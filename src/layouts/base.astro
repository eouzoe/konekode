---
import '@/styles/base.css';

interface Props {
  title: string;
  full?: boolean;
}

const { title, full = false } = Astro.props;
---

<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}｜Konekode 貓貓競程</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script>
      import { startIntake } from '@/lib/intake/mount';

      void startIntake();
    </script>
  </head>
  <body>
    <main class:list={[full ? 'full' : 'page']}><slot /></main>
  </body>
</html>
