---
import '@/styles/base.css';

import { absolute, indexable, robotsMeta, scriptJson, site, type Page } from '@/lib/site/pages';

interface Props {
  page: Page;
  data: Readonly<Record<string, unknown>>;
  full?: boolean;
}

const { page, data, full = false } = Astro.props;
const origin = Astro.site ?? Astro.url;
const address = absolute(origin, page.path);
const robots = robotsMeta(indexable(import.meta.env.PUBLIC_INDEX));
const structured = scriptJson(data);
---

<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="description" content={page.description} />
    <link rel="canonical" href={address} />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={address} />
    <meta name="twitter:card" content="summary" />
    <title>{page.title}</title>
    <script type="application/ld+json" is:inline set:html={structured} />
    <script>
      import { startDev } from '@/lib/dev/start';
      import { guard, watchUncaught } from '@/lib/fault/fault';
      import { mountNotice } from '@/lib/fault/notice';
      import { watchIntents } from '@/lib/site/intent';
      import { startLater } from '@/lib/site/later';
      import { reloadOnStaleCode } from '@/lib/site/stale';

      watchUncaught();
      reloadOnStaleCode();
      const notice = document.querySelector<HTMLElement>('[data-role="site-notice"]');
      if (notice !== null) {
        mountNotice(notice);
      }
      startLater();
      watchIntents(navigator.userAgent);
      if (import.meta.env.PUBLIC_MODE === 'dev') {
        guard('dev', startDev());
      }
    </script>
  </head>
  <body>
    <p class="site-notice" data-role="site-notice" role="status" aria-live="polite" hidden></p>
    <main class:list={[full ? 'full' : 'page']}><slot /></main>
  </body>
</html>

<style>
  .site-notice {
    position: fixed;
    inset: 0.5rem 0.5rem auto;
    z-index: 10;
    max-width: 40rem;
    margin: 0 auto;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    background: var(--notice-bg, #fff4d6);
    color: var(--notice-fg, #3d2f00);
    font-size: 0.9rem;
    line-height: 1.5;
    box-shadow: 0 1px 4px rgb(0 0 0 / 15%);
  }

  .site-notice[hidden] {
    display: none;
  }
</style>
