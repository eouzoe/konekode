{
  "name": "cp-lab-site",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@87a704b",
      "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@87a704b",
      "@types/bun": "1.4.4",
      "effect": "4.1.6"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && effect-tsgo tsc --noEmit --runExternalCode -p tsconfig.typecheck.json && tsc -p sw/tsconfig.json && effect-tsgo tsc --noEmit -p packages/contracts && effect-tsgo tsc --noEmit -p packages/course && effect-tsgo tsc --noEmit -p packages/views",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/drizzle": "2.0.0-beta.87",
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.1",
    "@effect/sql-d1": "4.1.6",
    "@effect/ui": "catalog:",
    "@effect/ui-kit": "catalog:",
    "@fingerprintjs/fingerprintjs": "5.3.0",
    "@konekode/contracts": "workspace:*",
    "@konekode/course": "workspace:*",
    "@konekode/views": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@rrweb/record": "2.2.2",
    "@yowasp/clang": "^22.0.0-git20695-13",
    "alchemy": "2.0.0-beta.87",
    "astro": "^7.4.13",
    "birpc": "^4.2.0",
    "brotli-dec-wasm": "^2.3.2",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "catalog:",
    "gsap": "3.15.1",
    "isbot": "^5.2.4",
    "konekode-engine": "https://github.com/eouzoe/konekode-engine/releases/download/v0.1.2/konekode-engine-0.1.2.tgz",
    "pixi-filters": "^6.1.5",
    "pixi.js": "8.23.0",
    "serwist": "9.6.0",
    "ts-fsrs": "6.0.1",
    "xstate": "6.0.0-beta.3",
    "zod": "^4.6.7"
