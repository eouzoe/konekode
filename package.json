    "fast-check": "^4.11.0",
    "oxfmt": "^0.80.0",
    "oxlint": "1.94.0",
    "sirv": "^3.0.2",
    "typescript": "7.1.0-beta",
    "vite": "8.4.0"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@alchemy.run/cloudflare-runtime@2.0.0-beta.87": "patches/@alchemy.run%2Fcloudflare-runtime@2.0.0-beta.87.patch"
