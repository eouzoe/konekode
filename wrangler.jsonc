{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/parts/*", "/api/*", "/learn/*"],
  },
  "d1_databases": [
    {
      "binding": "INTAKE",
      "database_name": "cp-intake",
      "migrations_dir": "migrations",
    },
  ],
}
