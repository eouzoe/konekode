{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "style",
      "type",
      "unknown"
    ],
    "newlinesBetween": true
  },
  "sortPackageJson": true,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "dist-dev",
    ".astro",
    ".wrangler",
    "public/google*.html"
  ]
}
